// ConnectMax CRM IA - SQLite Schema for Automated Testing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  document  String   @unique
  email     String
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  settings      CompanySettings?
  auditLogs     AuditLog[]
  contacts      Contact[]
  leads         Lead[]
  tasks         Task[]
  interactions  Interaction[]
  events        Event[]
  aiInsights    AiInsight[]
  conversations Conversation[]
  receivables      FinancialReceivable[]
  payables         FinancialPayable[]
  subscription     Subscription?
  paymentHistories PaymentHistory[]
  supportTickets   SupportTicket[]
  subscriptionHistories SubscriptionHistory[]

  @@map("companies")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id        String   @id @default(uuid())
  companyId String
  roleId    String
  name      String
  email     String   @unique
  password  String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                  Role           @relation(fields: [roleId], references: [id])
  sessions              Session[]
  auditLogs             AuditLog[]
  assignedLeads         Lead[]
  assignedTasks         Task[]
  interactions          Interaction[]
  assignedEvents        Event[]
  aiInsights            AiInsight[]
  assignedConversations Conversation[]
  tickets               SupportTicket[]
  ticketMessages        TicketMessage[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model CompanySettings {
  id                  String   @id @default(uuid())
  companyId           String   @unique
  logo                String?
  primaryColor        String   @default("#2563EB")
  timezone            String   @default("America/Sao_Paulo")
  onboardingCompleted Boolean  @default(false)
  onboardingProgress  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  payload   String?
  ipAddress String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@map("audit_logs")
}

model Contact {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  email       String?
  phone       String?
  document    String?
  type        String   @default("INDIVIDUAL")
  companyName String?
  position    String?
  notes       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads         Lead[]
  tasks         Task[]
  interactions  Interaction[]
  events        Event[]
  conversations Conversation[]
  receivables   FinancialReceivable[]

  @@index([companyId])
  @@index([email])
  @@map("contacts")
}

model Lead {
  id             String    @id @default(uuid())
  companyId      String
  contactId      String?
  assignedUserId String?
  title          String
  source         String?
  status         String    @default("NEW_LEAD")
  value          Float     @default(0.0)
  notes          String?
  aiScore        String?
  aiReasoning    String?
  aiScoreDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact     Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser User?                @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  tasks       Task[]
  interactions Interaction[]
  events      Event[]
  receivables FinancialReceivable[]

  @@index([companyId])
  @@index([contactId])
  @@index([assignedUserId])
  @@map("leads")
}

model Task {
  id             String   @id @default(uuid())
  companyId      String
  contactId      String?
  leadId         String?
  assignedUserId String?
  title          String
  description    String?
  dueDate        DateTime
  priority       String   @default("MEDIUM")
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([assignedUserId])
  @@map("tasks")
}

model Interaction {
  id          String   @id @default(uuid())
  companyId   String
  contactId   String?
  leadId      String?
  userId      String?
  type        String   @default("NOTE")
  title       String
  description String?
  createdAt   DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@map("interactions")
}

model Event {
  id             String   @id @default(uuid())
  companyId      String
  contactId      String?
  leadId         String?
  assignedUserId String?
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedUser User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([assignedUserId])
  @@map("events")
}

model AiInsight {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  type      String
  targetId  String?
  prompt    String
  response  String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@map("ai_insights")
}

model Conversation {
  id             String   @id @default(uuid())
  companyId      String
  contactId      String?
  assignedUserId String?
  phone          String
  status         String   @default("AI_ATTENDING")
  intent         String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([companyId])
  @@index([phone])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderType     String   @default("CLIENT")
  senderName     String?
  content        String
  suggestedReply String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model FinancialReceivable {
  id          String    @id @default(uuid())
  companyId   String
  contactId   String?
  leadId      String?
  description String
  amount      Float
  dueDate     DateTime
  paymentDate DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([contactId])
  @@map("financial_receivables")
}

model FinancialPayable {
  id          String    @id @default(uuid())
  companyId   String
  supplier    String
  category    String
  description String
  amount      Float
  dueDate     DateTime
  paymentDate DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("financial_payables")
}

model Plan {
  id           String   @id @default(uuid())
  name         String   @unique
  price        Float
  billingCycle String   @default("MONTHLY")
  maxUsers     Int      @default(3)
  maxContacts  Int      @default(500)
  features     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions         Subscription[]
  subscriptionHistories SubscriptionHistory[]

  @@map("plans")
}

model Subscription {
  id                     String    @id @default(uuid())
  companyId              String    @unique
  planId                 String
  status                 String    @default("TRIAL_ACTIVE") // ACTIVE, TRIALING, TRIAL_ACTIVE, EXPIRED, PAST_DUE, CANCELED
  isTrial                Boolean   @default(true)
  trialEndsAt            DateTime?
  startDate              DateTime  @default(now())
  nextBillingDate        DateTime
  lastPaymentDate        DateTime?
  paymentProvider        String?   @default("SIMULATED")
  externalSubscriptionId String?
  externalCustomerId     String?
  externalPaymentId      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model PaymentHistory {
  id             String   @id @default(uuid())
  companyId      String
  subscriptionId String
  amount         Float
  status         String   // APPROVED, DECLINED, REFUNDED
  provider       String   // STRIPE, MERCADO_PAGO, SIMULATED
  transactionId  String
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("payment_histories")
}

model CommercialLead {
  id            String          @id @default(uuid())
  name          String
  companyName   String
  email         String
  phone         String
  usersCount    Int
  status        String          @default("Novo Lead") // Novo Lead, Contato Inicial, Demonstração Agendada, Proposta Enviada, Negociação, Cliente Ativo, Perdido
  planName      String          @default("Professional")
  responsibleId String?
  notes         String?
  createdAt     DateTime        @default(now())

  responsible   CommercialUser? @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  @@map("commercial_leads")
}

model CommercialUser {
  id        String           @id @default(uuid())
  name      String
  email     String           @unique
  team      String           @default("Vendas SaaS")
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())

  leads     CommercialLead[]

  @@map("commercial_users")
}

model SupportTicket {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  subject     String
  description String
  priority    String   @default("MEDIA") // BAIXA, MEDIA, ALTA, URGENTE
  status      String   @default("ABERTO") // ABERTO, EM_ANALISE, AGUARDANDO_CLIENTE, RESOLVIDO, FECHADO
  category    String   @default("SUPORTE") // FINANCEIRO, WHATSAPP, IA, GERAL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  TicketMessage[]

  @@index([companyId])
  @@index([userId])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  message   String
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

model SubscriptionHistory {
  id        String   @id @default(uuid())
  companyId String
  planId    String
  status    String   // TRIAL_ACTIVE, ACTIVE, CANCELED, EXPIRED
  action    String   // CREATE, UPGRADE, DOWNGRADE, CANCEL, EXPIRE
  price     Float
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("subscription_histories")
}

model SaasEvent {
  id        String   @id @default(uuid())
  type      String   // CHURN, CONVERSION, REVENUE
  companyId String?
  amount    Float    @default(0)
  notes     String?
  createdAt DateTime @default(now())

  @@map("saas_events")
}
