model AiWorkflowNode {
  id         String   @id @default(uuid())
  workflowId String
  type       String
  name       String
  config     String?
  positionX  Float    @default(0)
  positionY  Float    @default(0)
  createdAt  DateTime @default(now())

  workflow AiWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("ai_workflow_nodes")
}

model AiWorkflowEdge {
  id           String   @id @default(uuid())
  workflowId   String
  sourceNodeId String
  targetNodeId String
