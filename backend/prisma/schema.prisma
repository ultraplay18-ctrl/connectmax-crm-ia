model CompanySecret {
  id             String   @id @default(uuid())
  companyId      String
  keyName        String   // OPENAI_API_KEY, CLAUDE_API_KEY, GEMINI_API_KEY, etc.
  encryptedValue String   // AES-256-GCM
  maskedValue    String   // sk-proj-...8A3f
  category       String   @default("PROVIDER") // PROVIDER, MCP, WEBHOOK, API
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, keyName])
  @@index([companyId])
  @@map("company_secrets")
}

model CompanyProvider {
  id                String   @id @default(uuid())
  companyId         String
  providerName      String   // OpenAI, Anthropic, Google Gemini, DeepSeek, Grok, Ollama, OpenRouter
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, DEGRADED
  defaultModel      String   @default("gpt-4o")
  timeoutMs         Int      @default(30000)
  retryCount        Int      @default(3)
  fallbackEnabled   Boolean  @default(true)
  streamingEnabled  Boolean  @default(true)
  dailyTokenLimit   Int      @default(1000000)
  monthlyTokenLimit Int      @default(30000000)
  requestTokenLimit Int      @default(8192)
  monthlyCostUsd    Float    @default(0.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, providerName])
  @@index([companyId])
  @@map("company_providers")
}

model CompanyProviderModel {
  id            String   @id @default(uuid())
  companyId     String
  providerName  String
  modelSlug     String
  modelName     String
  description   String?
  contextWindow Int      @default(128000)
  maxOutput     Int      @default(4096)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_provider_models")
}

model CompanyFallbackChain {
